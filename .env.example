# Site
NEXT_PUBLIC_SITE_URL=https://example.com

# Internationalization
# Default locale has no URL prefix (/about). Other locales are prefixed (/en/about).
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_LOCALES=en,ar
NEXT_PUBLIC_RTL_LOCALES=ar
NEXT_PUBLIC_LOCALE_IGNORED_PATHS=api,rpc,dashboard,_next,_vercel
NEXT_PUBLIC_LOCALE_COOKIE=NEXT_LOCALE
